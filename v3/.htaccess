Options -MultiViews -Indexes
DirectoryIndex index.php

<FilesMatch "^(config(\.sample)?\.php|schema\.sql|README\.md)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------
#  URL から .php を消す（member.php?id=1 → member?id=1）
#    1. 昔の .php 付き URL（ブックマーク・共有済みリンク）は .php なしへ 301 で飛ばす
#       THE_REQUEST = ブラウザが送ってきた元のリクエスト行。下の 3. で中だけ .php を付けた後には
#       引っかからないので、ループしない。POST は飛ばすと送った中身が消えるので GET / HEAD だけ
#    2. index.php は「./」へ
#    3. .php なしで来たら、同じ名前の .php があれば中だけでそれを動かす（URL はそのまま）
# ---------------------------------------------------------------------
RewriteEngine On

# 外から見えてはいけないものは 404（「ある」ことも教えない）
#   . で始まるファイル・フォルダ（.claude/ .git/ .gitignore など）、DB の変更履歴（migrations/）、テスト（tests/。名簿の見本が入っている）、
#   PHP の部品（lib/ partials/）、ログイン中のセッション（storage/。読まれたら他人になりすませる）、.sql / .md / .bak などの中身が読めてしまうファイル
RewriteRule (^|/)\. - [R=404,L]
RewriteRule ^(migrations|tests|lib|partials|storage)(/|$) - [R=404,L]
RewriteRule \.(sql|md|bak|log|ini|sh|zip|xlsx|csv)$ - [R=404,L,NC]

RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s[^?\s]*/index\.php[?\s]
RewriteCond %{REQUEST_URI} ^(.*/)index\.php$
RewriteRule ^index\.php$ %1 [R=301,L]

RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s[^?\s]*\.php[?\s]
RewriteCond %{REQUEST_URI} ^(.*)\.php$
RewriteRule ^[^/]+\.php$ %1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/.]+)$ $1.php [L]
